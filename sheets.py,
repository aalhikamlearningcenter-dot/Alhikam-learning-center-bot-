import os
import requests

GOOGLE_SCRIPT_URL = os.getenv("GOOGLE_SCRIPT_URL")


def save_to_google_sheet(data):
    try:
        response = requests.post(
            GOOGLE_SCRIPT_URL,
            json=data,
            timeout=30
        )

        if response.status_code == 200:
            return True

        return False

    except Exception as e:
        print("Google Sheets Error:", e)
        return False